# Pick the provider variables that match LAB_MODEL.
LAB_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# Module 05: Firecrawl hosted Streamable HTTP MCP.
# The hosted endpoint has a rate-limited keyless tier; add a key for higher limits.
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_API_KEY=

# Module 02: Linear hosted Streamable HTTP MCP.
# Use a scoped key and a sandbox/test team for the optional external write.
LINEAR_MCP_URL=https://mcp.linear.app/mcp
LINEAR_API_KEY=
LINEAR_TEAM=

# Module 02 enterprise extension: connect GitHub in CrewAI AMP, then copy the
# Enterprise Token from Integration Settings. GitHub access is read-only here.
CREWAI_PLATFORM_INTEGRATION_TOKEN=
# Defaults to the public CrewAI repository when left blank.
GITHUB_OWNER=crewAIInc
GITHUB_REPO=crewAI

# Optional: isolate memory for repeated workshops.
CREWAI_STORAGE_DIR=./storage
